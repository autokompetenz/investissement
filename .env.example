# =============================================================================
# Variables d'environnement — modèle
#
# Ce fichier suit le dépôt ; la copie locale (`.env`) et celle de Vercel, non.
# Seule la forme est donnée ici, jamais les valeurs.
#
# Vercel : Project Settings → Environment Variables — mêmes clés, sans
# commentaire.
#
# -----------------------------------------------------------------------------
# La frontière qui décide de tout
#
# Vite n'injecte dans le bundle client que les variables préfixées par VITE_.
# Une variable ainsi préfixée finit dans le JavaScript téléchargé par le
# navigateur : toute personne qui ouvre les sources la lit.
#
# NE JAMAIS préfixer DATABASE_URL ni une clé de chiffrement par VITE_. Le mot de
# passe se retrouverait écrit dans un fichier public, puis dans le cache du
# navigateur. Ce n'est pas un risque théorique, c'est la fuite la plus facile à
# provoquer du projet.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de données
#
# Neon → Dashboard → Connection Details → Copy connection string
# Contient le mot de passe du rôle : cette variable reste côté serveur.
#
# Le rôle est `invest_api`, et il doit être NON propriétaire. Le propriétaire
# d'une table contourne toujours sa RLM, sans exception possible : l'application
# verrait alors le grand livre, les IBAN et le journal d'audit des autres
# comptes. `neondb_owner` ne sert qu'à appliquer les migrations.
#
# L'application n'est encore reliée à rien : `src/services/` travaille en
# localStorage et aucun fichier ne lit `import.meta.env`. Ce modèle décrit ce
# que le serveur lira le jour où la bascule sera faite.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://invest_api:MOT-DE-PASSE@HOST/neondb?sslmode=require"


# -----------------------------------------------------------------------------
# Chiffrement
#
# À générer avec `openssl rand -base64 32`, puis 16 pour le poivre.
#
# Aucune des deux ne se tourne après la mise en service : les secrets chiffrés
# deviendraient illisibles, et les mots de passe existants ne correspondraient
# plus. Une rotation suppose de déchiffrer puis rechiffrer, jamais de remplacer.
#
# PASSWORD_PEPPER n'est pas un sel : Argon2id tire son propre sel par hachage et
# l'inscrit dans la chaîne produite. Le poivre est une seconde entrée tenue hors
# de la base, identique pour tous les comptes.
# -----------------------------------------------------------------------------
TOTP_ENCRYPTION_KEY=""
PASSWORD_PEPPER=""


# -----------------------------------------------------------------------------
# Service
#
# Le front lit `import.meta.env.PROD` et `import.meta.env.MODE`, pas NODE_ENV.
# Celui-ci sert au code serveur et aux scripts.
#
# APP_URL doit correspondre à ALLOWED_ORIGINS, sinon les liens d'activation et
# de réinitialisation partent vers un domaine que le client ne visite pas.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
APP_URL="http://localhost:5173"
NODE_ENV="development"


# -----------------------------------------------------------------------------
# Courriel
#
# §21 prévoit l'email comme canal. La file existe (`db/migrations/0004`) mais
# rien ne part encore : il n'y a pas de serveur. L'application est une page
# unique qui travaille en localStorage, elle n'a pas d'où envoyer.
#
# NE JAMAIS préfixer par VITE_ : un identifiant SMTP dans le bundle client est
# un mot de passe en clair, lisible par tout visiteur et mis en cache par le
# navigateur. C'est serveur ou rien.
#
# Pour un envoi transactionnel, la boîte doit être sur le domaine pour lequel
# SPF, DKIM et DMARC sont publiés — voir hPanel → Email → Email Delivery → DNS.
# Un message signé pour un domaine et émis depuis un autre part en spam, quelle
# que soit la configuration.
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"

SMTP_USER="no-reply@VOTRE-DOMAINE"
SMTP_PASSWORD=""

SMTP_FROM="no-reply@VOTRE-DOMAINE"
SMTP_FROM_NAME="Plateforme d'investissement"

# Nombre de tentatives, et délai avant la deuxième, en minutes. Le délai double
# à chaque essai : un service SMTP qui refuse n'est pas forcément mort.
SMTP_MAX_ATTEMPTS="4"
SMTP_RETRY_DELAY_MINUTES="15"

# Maximum d'emails par heure et par destinataire. Au-delà, la file attend.
# Un client qui déclenche cent rappels n'est pas un client qu'on spamme.
EMAIL_RATE_LIMIT_PER_HOUR="5"


# -----------------------------------------------------------------------------
# Stockage objet
#
# Les pièces KYC sont des documents d'identité : elles ne vont pas dans la base,
# qui finit dans des sauvegardes que personne n'a prévu de chiffrer. Le schéma
# n'en garde que la clé (`kyc_documents.storage_key`) ; l'API renvoie une URL
# signée, qui expire, jamais un lien permanent.
#
# Prévoir une durée de validité courte, et un nom de bucket.
# -----------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
KYC_STORAGE_BUCKET=""
KYC_SIGNED_URL_TTL_SECONDS="300"
KYC_MAX_FILE_SIZE_BYTES="2097152"


# -----------------------------------------------------------------------------
# Surveillance de la blockchain
#
# Sans accès à un nœud, personne ne voit qu'une transaction a eu lieu : les
# confirmations se comptent sur la chaîne, elles ne se déclarent pas. Si la
# surveillance est faite autrement, ces variables restent vides — mais que ce
# soit un choix assumé, et non un oubli.
# -----------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_RPC_KEY=""

# Purge des transactions crypto jamais confirmées, en heures. Au-delà, la ligne
# disparaît : un dépôt qui n'a jamais été confirmé n'est pas un dépôt.
CRYPTO_TX_RETENTION_HOURS="72"
